---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'CaribeVIP - Paquetes de viaje todo incluido a San Andrés, Santa Marta, Aruba, México y más. Salidas desde Cali y Medellín. Tiquetes, alojamiento, tours y asistencia médica.' } = Astro.props;
const siteUrl = 'https://caribe-vip-web.caribevip-travel.workers.dev';
const ogImage = `${siteUrl}/og-image.jpg`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="viajes, paquetes turísticos, San Andrés, Santa Marta, Aruba, México, todo incluido, agencia de viajes, Cali, Medellín, Colombia, CaribeVIP" />
    <meta name="author" content="CaribeVIP" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph (Facebook, WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="CaribeVIP" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>

    <!-- Schema.org JSON-LD: Travel Agency -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TravelAgency",
      "name": "CaribeVIP",
      "description": "Agencia de viajes con paquetes todo incluido a destinos del Caribe y más. Salidas desde Cali y Medellín.",
      "url": siteUrl,
      "telephone": "+573052952608",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "CO"
      },
      "areaServed": ["Colombia"],
      "priceRange": "$$",
      "sameAs": []
    })} />

    <!-- Schema.org JSON-LD: Product Offers -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Paquetes de viaje CaribeVIP",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "item": {
            "@type": "TouristTrip",
            "name": "San Andrés - 5 días / 4 noches",
            "description": "Paquete todo incluido desde Cali. Tiquetes LATAM, alojamiento, desayuno, tours y asistencia médica.",
            "touristType": "Beach",
            "offers": {
              "@type": "Offer",
              "price": "1220000",
              "priceCurrency": "COP",
              "availability": "https://schema.org/InStock"
            }
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "item": {
            "@type": "TouristTrip",
            "name": "Santa Marta - 4 días / 3 noches",
            "description": "Paquete desde Cali con tiquetes, traslados, alojamiento, alimentación y tour Playa Blanca.",
            "touristType": "Beach",
            "offers": {
              "@type": "Offer",
              "price": "999000",
              "priceCurrency": "COP",
              "availability": "https://schema.org/InStock"
            }
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "item": {
            "@type": "TouristTrip",
            "name": "México + Grutas de Tolantongo - 5 días / 4 noches",
            "description": "Semana de receso. Tiquetes AVIANCA, hotel, desayunos, tours por Ciudad de México, Teotihuacán y Grutas de Tolantongo.",
            "touristType": "Cultural",
            "offers": {
              "@type": "Offer",
              "price": "4399000",
              "priceCurrency": "COP",
              "availability": "https://schema.org/InStock"
            }
          }
        },
        {
          "@type": "ListItem",
          "position": 4,
          "item": {
            "@type": "TouristTrip",
            "name": "Aruba Happy Island - Todo incluido",
            "description": "Desde Medellín con Wingo. Hotel Coconut Inn, todas las comidas, traslados y tours incluidos.",
            "touristType": "Beach",
            "offers": {
              "@type": "Offer",
              "price": "4860000",
              "priceCurrency": "COP",
              "availability": "https://schema.org/InStock"
            }
          }
        }
      ]
    })} />
  </head>
  <body class="font-body bg-[#060e1a] text-gray-200">
    <!-- Imagen de fondo fija (GPU-accelerated) -->
    <div class="fixed inset-0 -z-20">
      <img src="/images/banner/dji_fly_20230211_122736_48_1676136481889_photo.jpg" alt="" class="w-full h-full object-cover" aria-hidden="true" />
    </div>
    <div class="fixed inset-0 bg-[#060e1a]/60 -z-10"></div>
    <slot />
    <!-- WhatsApp Floating Button -->
    <a
      href="https://wa.me/573052952608?text=Hola%20CaribeVIP%2C%20quiero%20información%20sobre%20los%20paquetes%20de%20viaje"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-6 right-6 z-50 bg-green-500 hover:bg-green-600 text-white rounded-full p-4 shadow-lg transition-transform hover:scale-110"
      aria-label="Contactar por WhatsApp"
    >
      <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>
  </body>
</html>
