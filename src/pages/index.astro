---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PackageCard from '../components/PackageCard.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="CaribeVIP - Paquetes de viaje todo incluido">
  <Header />
  <Hero />

  <!-- Paquetes -->
  <section id="paquetes" class="max-w-7xl mx-auto px-4 py-16">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-gray-900 mb-3">Nuestros Paquetes</h2>
      <p class="text-gray-500 max-w-xl mx-auto">Destinos increíbles con todo incluido. Tiquetes, alojamiento, tours y asistencia médica.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
      <PackageCard
        destination="San Andrés"
        origin="Cali"
        duration="5 días / 4 noches"
        price="$1.220.000"
        dates="Junio 21 al 25"
        badge="Popular"
        image="https://images.unsplash.com/photo-1590523741831-ab7e8b8f9c7f?w=600&h=400&fit=crop"
        includes={[
          'Tiquetes aéreos LATAM',
          'Morral 6 kg',
          'Alojamiento 4 noches',
          'Desayuno',
          'Combo Tours',
          'Asistencia médica'
        ]}
        highlights={[
          'Vuelta a la isla',
          'Acuario y Johnny Cay',
          'Tour bahía'
        ]}
      />

      <PackageCard
        destination="Santa Marta"
        origin="Cali"
        duration="4 días / 3 noches"
        price="$999.000"
        priceLabel="Desde"
        dates="Junio y Julio — Múltiples fechas"
        image="https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=600&h=400&fit=crop"
        includes={[
          'Tiquetes aéreos',
          'Morral cabina 6 kg',
          'Traslados In-Out',
          'Alojamiento 3 noches',
          'Alimentación según hotel',
          'Tour Playa Blanca',
          'Asistencia médica'
        ]}
      />

      <PackageCard
        destination="México + Grutas de Tolantongo"
        origin="Colombia"
        duration="5 días / 4 noches"
        price="$4.399.000"
        priceLabel="Desde (múltiple)"
        dates="Octubre 6 al 10, 2026 — Semana de receso"
        badge="Internacional"
        image="https://images.unsplash.com/photo-1518638150340-f706e86654de?w=600&h=400&fit=crop"
        includes={[
          'Tiquetes AVIANCA ida y regreso',
          'Traslado aeropuerto-hotel',
          '4 noches Hotel Estoril o similar',
          '4 desayunos',
          'Tour Ciudad de México',
          'Basílica de Guadalupe',
          'Pirámides de Teotihuacán',
          'Grutas de Tolantongo',
          'Asistencia médica'
        ]}
        highlights={[
          'Centro Histórico, Zócalo, Palacio Nacional',
          'Ángel de la Independencia',
          'Separa con $500.000'
        ]}
      />

      <PackageCard
        destination="Aruba — Happy Island"
        origin="Medellín"
        duration="5 días / 4 noches"
        price="$4.860.000"
        priceLabel="Desde (doble)"
        dates="Bloqueos 2026-2027 — Múltiples fechas"
        badge="Todo incluido"
        image="https://images.unsplash.com/photo-1548574505-5e239809ee19?w=600&h=400&fit=crop"
        includes={[
          'Tiquetes Wingo ida y regreso',
          'Hotel Coconut Inn 4 noches',
          'Desayuno, almuerzo y cena',
          'Traslado grupal',
          'Asistencia médica de viaje',
          'Tours incluidos'
        ]}
        highlights={[
          'Eagle Beach, Manchebo Beach',
          'Faro California, Baby Beach',
          'Natural Bridge, Murales San Nicolás',
          'Niños desde $3.029.000'
        ]}
      />
    </div>
  </section>

  <!-- Nosotros -->
  <section id="nosotros" class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-gray-900 mb-3">¿Por qué CaribeVIP?</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center p-6">
          <div class="w-14 h-14 bg-caribe-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-caribe-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-lg mb-2">Seguridad y confianza</h3>
          <p class="text-sm text-gray-500">Viaja tranquilo con asistencia médica incluida en todos nuestros paquetes.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-14 h-14 bg-sol/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-sol" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-lg mb-2">Mejores precios</h3>
          <p class="text-sm text-gray-500">Paquetes todo incluido a precios competitivos. Sin costos ocultos.</p>
        </div>
        <div class="text-center p-6">
          <div class="w-14 h-14 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-lg mb-2">Atención personalizada</h3>
          <p class="text-sm text-gray-500">Te asesoramos por WhatsApp para armar el viaje perfecto para ti.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
