---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PackageCard from '../components/PackageCard.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ClientGallery from '../components/ClientGallery.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="CaribeVIP - Paquetes de viaje todo incluido | Agencia de Viajes">
  <Header />
  <Hero />
  <HowItWorks />

  <!-- Destinos Nacionales -->
  <section id="nacionales" class="bg-[#0a1628]/70 py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-8">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent to-sky-500/30"></div>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-white">
          🇨🇴 Destinos <span class="text-sky-400">Nacionales</span>
        </h2>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent to-sky-500/30"></div>
      </div>
      <p class="text-gray-400 text-center mb-10 max-w-lg mx-auto">Salidas desde Cali con todo incluido. Playas, tours y la mejor experiencia caribeña.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <PackageCard
          destination="San Andrés"
          origin="Cali"
          duration="4-5 días / 3-4 noches"
          price="$1.250.000"
          priceLabel="Desde"
          dates="Consulta fechas disponibles"
          badge="Popular"
          image="/images/san-andres.jpg"
          slug="san-andres"
          includes={[
            'Tiquetes aéreos morral 8kg',
            'Desayunos incluidos',
            'Alojamiento hotel turista',
            'Combo tours',
            'Traslados aeropuerto',
            'Seguro médico'
          ]}
          highlights={[
            'Vuelta a la isla',
            'Tour por la bahía en yate',
            'Acuario y Johnny Cay'
          ]}
        />

        <PackageCard
          destination="Cartagena"
          origin="Cali"
          duration="4-5 días / 3-4 noches"
          price="$899.000"
          priceLabel="Desde"
          dates="Consulta fechas disponibles"
          image="/images/cartagena.jpg"
          slug="cartagena"
          includes={[
            'Tiquetes aéreos morral 8kg',
            'Desayunos incluidos',
            'Alojamiento hotel turista',
            'Tour a Barú con almuerzo',
            'Traslados aeropuerto',
            'Seguro médico'
          ]}
        />

        <PackageCard
          destination="Santa Marta"
          origin="Cali"
          duration="4-5 días / 3-4 noches"
          price="$899.000"
          priceLabel="Desde"
          dates="Consulta fechas disponibles"
          image="/images/santa-marta.jpg"
          slug="santa-marta"
          includes={[
            'Tiquetes aéreos morral 8kg',
            'Desayunos incluidos',
            'Alojamiento hotel turista',
            'Tour Playa Blanca con almuerzo',
            'Traslados aeropuerto',
            'Seguro médico'
          ]}
        />

        <!-- Card especial: Combinado Cartagena + Santa Marta -->
        <a href="/destinos/cartagena-santa-marta" class="block h-full">
          <article class="bg-[#0a1628] border border-gray-700/50 rounded-2xl overflow-hidden hover:border-sky-500/40 hover:shadow-lg hover:shadow-sky-500/5 transition-all duration-300 flex flex-col group cursor-pointer h-full">
          <div class="relative h-48 md:h-56 overflow-hidden flex">
            <img src="/images/cartagena.jpg" alt="Cartagena" class="w-1/2 h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <img src="/images/santa-marta.jpg" alt="Santa Marta" class="w-1/2 h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a1628]/60 to-transparent"></div>
            <span class="absolute top-3 left-3 bg-amber-500 text-gray-900 text-xs font-bold px-3 py-1 rounded-full uppercase">Combinado</span>
            <div class="absolute top-3 right-3 bg-[#0a1628]/80 text-sky-400 text-xs font-semibold px-3 py-1 rounded-full backdrop-blur-sm">Desde Cali</div>
          </div>
          <div class="p-5 flex flex-col flex-1">
            <div class="flex items-center justify-between mb-2">
              <h3 class="font-display text-xl font-bold text-white">Cartagena + Santa Marta</h3>
              <span class="text-xs bg-sky-500/10 text-sky-400 px-2 py-1 rounded-full font-medium">5 días / 4 noches</span>
            </div>
            <p class="text-sm text-gray-400 mb-3">Consulta fechas disponibles</p>
            <div class="mb-4">
              <span class="text-2xl font-extrabold text-amber-400">$1.650.000</span>
              <span class="text-sm text-gray-400 ml-1">Desde</span>
            </div>
            <div class="mb-4 flex-1">
              <p class="text-xs font-semibold text-gray-400 uppercase mb-2">Incluye:</p>
              <ul class="grid grid-cols-2 gap-1">
                {['Tiquetes aéreos morral 8kg', 'Desayunos incluidos', '2 noches en Cartagena', '2 noches en Santa Marta', 'Tour Barú con almuerzo', 'Chiva rumbera'].map((item) => (
                  <li class="text-xs text-gray-300 flex items-center gap-1">
                    <svg class="w-3 h-3 text-sky-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    {item}
                  </li>
                ))}
                <li class="text-xs text-sky-400 font-medium">+5 más...</li>
              </ul>
            </div>
            <div class="mt-auto text-center text-sky-400 text-sm font-medium group-hover:text-sky-300 transition-colors">
              Ver detalles →
            </div>
          </div>
          </article>
        </a>
      </div>
    </div>
  </section>

  <!-- Destinos Internacionales -->
  <section id="internacionales" class="bg-[#060e1a]/70 py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-8">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent to-amber-500/30"></div>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-white">
          ✈️ Destinos <span class="text-amber-400">Internacionales</span>
        </h2>
        <div class="h-px flex-1 bg-gradient-to-l from-transparent to-amber-500/30"></div>
      </div>
      <p class="text-gray-400 text-center mb-10 max-w-lg mx-auto">Experiencias únicas fuera de Colombia. Acompañamiento 24 horas y asesoría migratoria.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <PackageCard
          destination="Punta Cana"
          origin="Colombia"
          duration="4 días / 3 noches"
          price="$2.999.000"
          priceLabel="Desde por persona"
          dates="Consulta fechas disponibles"
          badge="Todo incluido"
          image="/images/punta-cana.jpg"
          slug="punta-cana"
          includes={[
            'Tiquetes aéreos + equipaje',
            'Hotel todo incluido 3 noches',
            'Desayuno, almuerzo y cena buffet',
            'Snacks y bar abierto',
            'Piscinas y diversión sin límite',
            'Seguro médico internacional',
            'Traslados aeropuerto',
            'Asesoría migratoria 24h'
          ]}
        />

        <PackageCard
          destination="Cancún"
          origin="Colombia"
          duration="4 días / 3 noches"
          price="$2.899.000"
          priceLabel="Desde por persona"
          dates="Consulta fechas disponibles"
          badge="Todo incluido"
          image="/images/cancun.jpg"
          slug="cancun"
          includes={[
            'Tiquetes aéreos + equipaje',
            'Hotel todo incluido 3 noches',
            'Desayuno, almuerzo y cena buffet',
            'Snacks y bar abierto',
            'Piscinas y diversión sin límite',
            'Seguro médico internacional',
            'Traslados aeropuerto',
            'Asesoría migratoria 24h'
          ]}
        />

        <PackageCard
          destination="Aruba"
          origin="Colombia"
          duration="4 días / 3 noches"
          price="$3.550.000"
          priceLabel="Desde por persona"
          dates="Consulta fechas disponibles"
          image="/images/aruba.jpg"
          slug="aruba"
          includes={[
            'Tiquetes aéreos + equipaje',
            'Hotel turista 3 noches',
            'Desayunos incluidos',
            'Seguro médico internacional',
            'Traslados aeropuerto',
            'Asesoría migratoria 24h'
          ]}
        />

        <PackageCard
          destination="Curazao"
          origin="Colombia"
          duration="4 días / 3 noches"
          price="$3.750.000"
          priceLabel="Desde por persona"
          dates="Consulta fechas disponibles"
          badge="Todo incluido"
          image="/images/curazao.jpg"
          slug="curazao"
          includes={[
            'Tiquetes aéreos + equipaje',
            'Hotel todo incluido 3 noches',
            'Desayuno, almuerzo y cena buffet',
            'Snacks y bar abierto',
            'Piscinas y diversión sin límite',
            'Seguro médico internacional',
            'Traslados aeropuerto',
            'Asesoría migratoria 24h'
          ]}
        />

        <PackageCard
          destination="Jamaica"
          origin="Colombia"
          duration="4 días / 3 noches"
          price="$3.550.000"
          priceLabel="Desde por persona"
          dates="Consulta fechas disponibles"
          image="/images/jamaica.jpg"
          slug="jamaica"
          includes={[
            'Tiquetes aéreos + equipaje',
            'Hotel turista 3 noches',
            'Desayunos incluidos',
            'Seguro médico internacional',
            'Traslados aeropuerto',
            'Asesoría migratoria 24h'
          ]}
        />
      </div>
    </div>
  </section>

  <!-- Nosotros -->
  <section id="nosotros" class="bg-[#0a1628]/70 py-16">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-white mb-3">¿Por qué <span class="text-sky-400">CaribeVIP</span>?</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center p-6 bg-[#060e1a] rounded-2xl border border-gray-700/50">
          <div class="w-14 h-14 bg-sky-500/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-lg text-white mb-2">Seguridad y confianza</h3>
          <p class="text-sm text-gray-400">Asistencia médica incluida en todos nuestros paquetes. Viaja tranquilo.</p>
        </div>
        <div class="text-center p-6 bg-[#060e1a] rounded-2xl border border-gray-700/50">
          <div class="w-14 h-14 bg-amber-500/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-lg text-white mb-2">Mejores precios</h3>
          <p class="text-sm text-gray-400">Paquetes todo incluido a precios competitivos. Sin costos ocultos.</p>
        </div>
        <div class="text-center p-6 bg-[#060e1a] rounded-2xl border border-gray-700/50">
          <div class="w-14 h-14 bg-green-500/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-lg text-white mb-2">Atención personalizada</h3>
          <p class="text-sm text-gray-400">Te asesoramos por WhatsApp para armar el viaje perfecto.</p>
        </div>
      </div>
    </div>
  </section>

  <ClientGallery />

  <FAQ />

  <Footer />
</Layout>
