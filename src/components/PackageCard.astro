---
interface Props {
  destination: string;
  origin: string;
  duration: string;
  price: string;
  priceLabel?: string;
  dates: string;
  includes: string[];
  highlights?: string[];
  image: string;
  badge?: string;
}

const { destination, origin, duration, price, priceLabel = 'Por persona', dates, includes, highlights, image, badge } = Astro.props;
const whatsappMsg = encodeURIComponent(`Hola CaribeVIP, quiero información sobre el paquete a ${destination}`);
---
<article class="bg-[#0a1628] border border-gray-700/50 rounded-2xl overflow-hidden hover:border-sky-500/40 transition-all duration-300 flex flex-col group">
  <div class="relative h-48 md:h-56 overflow-hidden">
    <img src={image} alt={`Paquete ${destination}`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a1628]/60 to-transparent"></div>
    {badge && (
      <span class="absolute top-3 left-3 bg-amber-500 text-gray-900 text-xs font-bold px-3 py-1 rounded-full uppercase">
        {badge}
      </span>
    )}
    <div class="absolute top-3 right-3 bg-[#0a1628]/80 text-sky-400 text-xs font-semibold px-3 py-1 rounded-full backdrop-blur-sm">
      Desde {origin}
    </div>
  </div>
  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-display text-xl font-bold text-white">{destination}</h3>
      <span class="text-xs bg-sky-500/10 text-sky-400 px-2 py-1 rounded-full font-medium">{duration}</span>
    </div>
    <p class="text-sm text-gray-400 mb-3">{dates}</p>
    <div class="mb-4">
      <span class="text-2xl font-extrabold text-amber-400">{price}</span>
      <span class="text-sm text-gray-400 ml-1">{priceLabel}</span>
    </div>
    <div class="mb-4 flex-1">
      <p class="text-xs font-semibold text-gray-400 uppercase mb-2">Incluye:</p>
      <ul class="grid grid-cols-2 gap-1">
        {includes.map((item) => (
          <li class="text-xs text-gray-300 flex items-center gap-1">
            <svg class="w-3 h-3 text-sky-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            {item}
          </li>
        ))}
      </ul>
    </div>
    {highlights && highlights.length > 0 && (
      <div class="mb-4 p-3 bg-amber-500/10 border border-amber-500/20 rounded-lg">
        <p class="text-xs font-semibold text-amber-400 mb-1">Destacados:</p>
        <ul class="text-xs text-gray-300 space-y-0.5">
          {highlights.map((h) => <li>• {h}</li>)}
        </ul>
      </div>
    )}
    <a
      href={`https://wa.me/573052952608?text=${whatsappMsg}`}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-auto block text-center bg-green-500 hover:bg-green-400 text-white font-bold py-3 rounded-xl transition-colors"
    >
      Reservar por WhatsApp
    </a>
  </div>
</article>
