---
interface Props {
  destination: string;
  origin: string;
  duration: string;
  price: string;
  priceLabel?: string;
  dates: string;
  includes: string[];
  highlights?: string[];
  image: string;
  badge?: string;
}

const { destination, origin, duration, price, priceLabel = 'Por persona', dates, includes, highlights, image, badge } = Astro.props;
const whatsappMsg = encodeURIComponent(`Hola CaribeVIP, quiero información sobre el paquete a ${destination}`);
---
<article class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-shadow duration-300 flex flex-col">
  <div class="relative h-48 md:h-56 overflow-hidden">
    <img src={image} alt={`Paquete ${destination}`} class="w-full h-full object-cover" loading="lazy" />
    {badge && (
      <span class="absolute top-3 left-3 bg-sol text-white text-xs font-bold px-3 py-1 rounded-full uppercase">
        {badge}
      </span>
    )}
    <div class="absolute top-3 right-3 bg-white/90 text-gray-800 text-xs font-semibold px-3 py-1 rounded-full">
      Desde {origin}
    </div>
  </div>
  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-display text-xl font-bold text-gray-900">{destination}</h3>
      <span class="text-xs bg-caribe-100 text-caribe-700 px-2 py-1 rounded-full font-medium">{duration}</span>
    </div>
    <p class="text-sm text-gray-500 mb-3">{dates}</p>
    <div class="mb-4">
      <span class="text-2xl font-extrabold text-caribe-600">{price}</span>
      <span class="text-sm text-gray-500 ml-1">{priceLabel}</span>
    </div>
    <div class="mb-4 flex-1">
      <p class="text-xs font-semibold text-gray-600 uppercase mb-2">Incluye:</p>
      <ul class="grid grid-cols-2 gap-1">
        {includes.map((item) => (
          <li class="text-xs text-gray-600 flex items-center gap-1">
            <svg class="w-3 h-3 text-caribe-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            {item}
          </li>
        ))}
      </ul>
    </div>
    {highlights && highlights.length > 0 && (
      <div class="mb-4 p-3 bg-amber-50 rounded-lg">
        <p class="text-xs font-semibold text-amber-700 mb-1">Destacados:</p>
        <ul class="text-xs text-amber-800 space-y-0.5">
          {highlights.map((h) => <li>• {h}</li>)}
        </ul>
      </div>
    )}
    <a
      href={`https://wa.me/573104101184?text=${whatsappMsg}`}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-auto block text-center bg-green-500 hover:bg-green-600 text-white font-bold py-3 rounded-xl transition-colors"
    >
      Reservar por WhatsApp
    </a>
  </div>
</article>
